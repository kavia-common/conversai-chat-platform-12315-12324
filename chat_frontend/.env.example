# PUBLIC INTERFACE
# Frontend environment variables for chat_frontend (React)
# Note: Do NOT commit real secrets. This file documents variables required.

# Backend API base URL (e.g., http://localhost:8000 or /api)
REACT_APP_API_BASE_URL=http://localhost:8000

# Optional: If you want to allow users to provide an OpenAI API Key at runtime via UI prompt
# If not set, users can still input the key per request in the UI header input.
# REACT_APP_ALLOW_OPENAI_KEY_INPUT=true
